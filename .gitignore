# =============================================================================
# RAD manuscript repo — files that should never be tracked
# =============================================================================

# --- Large workspaces/checkpoints (distributed separately) ---
*.RData
*.Rdata
*.rda
*.rds

# --- R session / build artifacts ---
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj.user/
*_cache/
*_files/

# --- knitr / rmarkdown intermediates ---
*.knit.md
*.utf8.md
figure_*/figure_*_files/
figure_*/figure_*_analysis.html
figure_*/figure_*_analysis_regen.html

# --- Harness runtime manifests (regenerated on each run) ---
**/.last_demux_paths.txt

# --- macOS cruft ---
.DS_Store
**/.DS_Store

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*~

# --- OS / build ---
build/
*.o
*.so
*.dylib

# --- Python bytecode ---
__pycache__/
*.pyc
*.pyo

# --- Local-only notes (don't commit ad-hoc TODOs) ---
to_fix.txt
NOTES.local.md

# Full current checkpoints and release bundles are distributed separately.
/checkpoints/
/release_staging/
/release_archives/
/config/project.local.json
/.validation-work/
/.venv/

# Local scheduler logs are summarized by the checked-in validation receipts.
validation/*_job_*.log
validation/*_recount_*.out
validation/*_recount_*.err
validation/*_flexparity_*.out
validation/*_flexparity_*.err
validation/*_[0-9]*.out
validation/*_[0-9]*.err
