#!/usr/bin/env bash
# =============================================================================
# config.local.sh.example — copy to config.local.sh and edit for your machine
# =============================================================================
# This file documents every path the figure harness expects. Copy it once:
#
#     cp config.local.sh.example config.local.sh
#     $EDITOR config.local.sh
#
# config.local.sh is gitignored, so your private paths stay out of git history.
# Lines you don't change fall back to the placeholder defaults in config.sh.
# =============================================================================

# --- Tools you need on disk --------------------------------------------------
# Built RAD binary (https://github.com/indianewok/rad)
export RAD_BIN="/path/to/rad"
# RAD's auxiliary whitelist generator (built alongside the main binary)
export GEN_WL_BIN="/path/to/rad/build/generate_whitelist"
# BLAZE binary — only needed if you're regenerating the benchmark comparisons
export BLAZE_BIN="/path/to/blaze"

# --- Raw input FASTQs --------------------------------------------------------
# Root directory containing every dataset's *.fq.gz. The other FASTQ variables
# in config.sh derive from this root by default; override individual files
# below if your layout differs.
export RAW_FQ="/path/to/raw_fqs"

# --- Results roots (separate per tool to make benchmarks comparable) ---------
export RESULTS_BASE="/path/to/results/rad/demultiplexed"
export BLAZE_RESULTS="/path/to/results/blaze"
export FLEXIPLEX_RESULTS="/path/to/results/flexiplex"
export WL_DETECTION_RESULTS="/path/to/results/rad/whitelist_detection"

# --- Barcode whitelists ------------------------------------------------------
export WL_DIR="/path/to/barcode_whitelists"
# Auto-generated RAGEseq whitelist (per-run output of generate_whitelist)
export RAGESEQ_WL="/path/to/rageseq_autogenerated_bcs.txt"
# Auto-generated ScTagger whitelist
export SCTAGGER_GEN_WL="/path/to/sctagger_rad_generated.csv"

# --- Analysis project root ---------------------------------------------------
# Parent of project_specific_scripts/, barcode_whitelists/, and per-run
# benchmark/timing output directories that figure_3 R scripts read from.
export RAD_PAPER_DIR="/path/to/rad_paper"

# --- Project helper scripts (R + shell) used by the Rmds ---------------------
# Contains: process_extracted_headers.R, generate_sctagger_ids.R,
# comparing_visium_data.R, graphing_*.R, etc.
export PROJECT_SCRIPTS="/path/to/project_specific_scripts"

# --- RAD source-tree resources (read layouts, kit definitions) ---------------
export RAD_RESOURCES="/path/to/rad/resources"

# --- Optional / Figure-5 only ------------------------------------------------
# Local directory containing chr14 IGH-locus depth CSVs (T2T-mapped):
#   nbc_chr14_t2t_mapont.depth.csv, rsq_chr14_t2t_mapont.depth.csv
export NBC_DEPTH_DIR="/path/to/nbc_depth_data"

# Engblom et al. spatial tonsil dataset (Figures 4-5 Visium panels)
export SWEDISH_TONSIL_DIR="/path/to/swedish_tonsil_spatial"
